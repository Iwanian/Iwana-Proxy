// app.rc — embeds the application icon (converted from Android app icon).
101 ICON "assets/icon.ico"
201 RCDATA "assets/github_dark.png"
202 RCDATA "assets/github_light.png"
203 RCDATA "assets/telegram.png"
204 RCDATA "assets/flag_us.png"
205 RCDATA "assets/flag_ru.png"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Iwanian"
            VALUE "FileDescription",  "Iwana Proxy"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "IwanaProxy"
            VALUE "OriginalFilename", "IwanaProxy.exe"
            VALUE "ProductName",      "Iwana Proxy"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
